{
  "//": "Gust N1 v1.0 two-core system (n1_soc) on sky130. I-caches cut to 4 lines for layout: full 64-line caches built from flip-flops would need memory macros.",
  "DESIGN_NAME": "n1_soc",
  "VERILOG_FILES": "dir::rtl/*.v",
  "VERILOG_INCLUDE_DIRS": [
    "dir::rtl"
  ],
  "SYNTH_PARAMETERS": [
    "ICACHE_LINES=4",
    "ICACHE_LW=2"
  ],
  "CLOCK_PORT": "clk",
  "CLOCK_PERIOD": 50,
  "FP_SIZING": "absolute",
  "DIE_AREA": [
    0,
    0,
    1100,
    1100
  ],
  "PL_TARGET_DENSITY_PCT": 45,
  "GRT_ALLOW_CONGESTION": true,
  "RUN_KLAYOUT_XOR": false,
  "RUN_KLAYOUT_DRC": false
}